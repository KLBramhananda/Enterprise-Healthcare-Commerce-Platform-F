# ─────────────────────────────────────────────────────────────────────────────
# KeeMeds Commerce Frontend — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and adjust values for your environment.
#
#   cp .env.example .env.local        (macOS / Linux)
#   copy .env.example .env.local      (Windows)
#
# All VITE_* variables are inlined into the browser bundle at build time.
# Do NOT put secrets, passwords, or API keys here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
VITE_APP_ENV=development
VITE_APP_NAME=KeeMeds
VITE_APP_TAGLINE=Your Trusted Healthcare Partner
VITE_APP_DESCRIPTION=KeeMeds - Online Healthcare Commerce Platform

# ── API / Backend ─────────────────────────────────────────────────────────────
# Base URL for all backend requests.
#   Dev (same-origin, routed by the Vite proxy):  /api/method
#   Production (absolute backend origin):         https://api.example.com/api/method
VITE_API_BASE_URL=/api/method

# Backend origin the dev-server `/api` proxy forwards to.
VITE_PROXY_TARGET=http://localhost:8000

# Request timeout in milliseconds.
VITE_API_TIMEOUT=30000

# ── ERP Integration Mode ─────────────────────────────────────────────────────
# Set to true to use the real ERPNext HTTP client instead of mock services.
# WARNING: Requires ERPNext backend to be running and configured.
VITE_USE_ERP_API=false

# Set to false when USE_ERP_API is true and ERPNext services are implemented.
# When true, the service factory always resolves to mock implementations.
VITE_USE_MOCK_API=true

# Direct ERPNext backend URL for production/staging builds served without the
# Vite dev proxy. Leave empty in development (Vite proxy handles /api forwarding).
VITE_ERPNEXT_BACKEND_URL=

# Enable CORS-compatible headers for local dev against a remote ERPNext instance.
# Not needed when using the Vite dev proxy (it already handles CORS).
VITE_CORS_COMPAT_MODE=false

# ── Developer Tools ───────────────────────────────────────────────────────────
# Enables structured API request logging (method, URL, duration, status).
# Automatically disabled in production.
VITE_ENABLE_API_LOGGING=false

# Enables dev tools overlay. Automatically disabled in production.
VITE_ENABLE_DEV_TOOLS=true

# ── Data fetching defaults (React Query) ─────────────────────────────────────
VITE_QUERY_STALE_TIME=300000
VITE_QUERY_RETRY_COUNT=1

# ── Assets ────────────────────────────────────────────────────────────────────
# Optional CDN / media-server base URLs. Leave empty to serve from same-origin.
VITE_IMAGE_BASE_URL=
VITE_UPLOAD_BASE_URL=

# ── Mobile app store links ────────────────────────────────────────────────────
VITE_APP_STORE_URL=https://apps.apple.com/us/iphone/today
VITE_GOOGLE_PLAY_URL=https://play.google.com/store/apps?hl=en_IN

# ── Dev server ────────────────────────────────────────────────────────────────
VITE_DEV_PORT=5173

# ── Feature flags ─────────────────────────────────────────────────────────────
VITE_FEATURE_LIVE_CHAT=true
VITE_FEATURE_PRESCRIPTION_UPLOAD=true
VITE_FEATURE_LOYALTY=true
VITE_FEATURE_MEMBERSHIP=true
VITE_FEATURE_REFERRAL=true
VITE_FEATURE_COUPONS=true
VITE_FEATURE_APP_DOWNLOAD=true
VITE_FEATURE_HOME_DELIVERY=true
